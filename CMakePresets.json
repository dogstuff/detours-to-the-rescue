{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw32-nix",
      "displayName": "MinGW32 (Nix)",
      "description": "Cross-compile for Windows with the Nix MinGW32 toolchain",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/.toolchain/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DTTR_MODS_ENABLED": "OFF"
      }
    },
    {
      "name": "mingw32-nix-modding",
      "displayName": "MinGW32 (Nix, modding)",
      "description": "Reconfigure the MinGW32 build tree with modding enabled",
      "inherits": "mingw32-nix",
      "cacheVariables": {
        "DTTR_MODS_ENABLED": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw32-nix",
      "configurePreset": "mingw32-nix",
      "configuration": "debug"
    },
    {
      "name": "mingw32-nix-modding",
      "configurePreset": "mingw32-nix-modding",
      "configuration": "debug"
    }
  ]
}
