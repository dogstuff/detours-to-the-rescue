SIDECAR_GFX_BYTE_PATCH(
	"dttr_hook_render_quad_snap",
	false,
	DTTR_TEST_PCDOGS_REQUIRED_ALL,
	"53 8B 5C 24 14 55 33 C9 56 57 85 DB",
	0,
	(0xC3),
	(0x53),
	"x"
)
