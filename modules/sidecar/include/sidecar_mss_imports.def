// Single source of truth for the mss32.dll (Miles Sound System) imports the sidecar hooks.
//
// Included by both the runtime (modules/sidecar/src/audio/mss_sdl.c, which expands each row
// into an mss_import_hook with its SDL replacement callback) and the sidecar pcdogs test
// (which expands each row into the expected import name). The includer defines
// SIDECAR_MSS_IMPORT before including and undefines it afterwards.
//
// Fields:
//   hook_name   - stable hook name (string literal)
//   import_name - decorated mss32.dll import symbol ("_AIL_close_stream@4")
//   callback    - SDL replacement function (runtime only; unused by the test expander)

#ifndef SIDECAR_MSS_IMPORT
#error "define SIDECAR_MSS_IMPORT before including sidecar_mss_imports.def"
#endif

SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_allocate_sample_handle",
	"_AIL_allocate_sample_handle@4",
	dttr_mss_ail_allocate_sample_handle
)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_close_stream",
	"_AIL_close_stream@4",
	dttr_mss_ail_close_stream
)
SIDECAR_MSS_IMPORT("dttr_hook_mss_ail_end_sample", "_AIL_end_sample@4", dttr_mss_ail_end_sample)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_get_preference",
	"_AIL_get_preference@4",
	dttr_mss_ail_get_preference
)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_init_sample",
	"_AIL_init_sample@4",
	dttr_mss_ail_init_sample
)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_open_stream",
	"_AIL_open_stream@12",
	dttr_mss_ail_open_stream
)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_pause_stream",
	"_AIL_pause_stream@8",
	dttr_mss_ail_pause_stream
)
SIDECAR_MSS_IMPORT(
	"dttr_hook_mss_ail_release_sample_handle",
