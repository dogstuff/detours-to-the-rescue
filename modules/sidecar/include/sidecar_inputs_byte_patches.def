// Input byte patch rows share runtime patch bytes with pcdogs expectations.

#ifndef SIDECAR_INPUTS_BYTE_PATCH
#error "define SIDECAR_INPUTS_BYTE_PATCH before including sidecar_inputs_byte_patches.def"
#endif

SIDECAR_INPUTS_BYTE_PATCH(
	"dttr_inputs_controls_enter_bind_branch",
	DTTR_SIDECAR_AOB_CONTROLS_ENTER_BIND_BRANCH,
	19,
	(0x90, 0x90, 0x90, 0x90, 0x90, 0x90),
	(0x0F, 0x84, 0x00, 0x00, 0x00, 0x00),
	"xx????"
)
