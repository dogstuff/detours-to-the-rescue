shader-output-dir := env_var_or_default("SHADER_OUTPUT_DIR", "build/modules/sidecar/generated/include/gen")
docker := env_var_or_default("DOCKER", "podman")
shader-container-image := "docker.io/nixos/nix:latest"

# Builds generated shader headers and blobs in the build tree.
build-shaders:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{invocation_directory()}}"
    echo "Compiling SDL3 GPU shaders to \"{{shader-output-dir}}\""
    bash "{{justfile_directory()}}/scripts/build-shaders.sh" "{{shader-output-dir}}"
    echo "Generating OpenGL shaders to \"{{shader-output-dir}}\""
    bash "{{justfile_directory()}}/scripts/build-opengl-shaders.sh" "{{shader-output-dir}}"

# Runs shader generation in a container so hosts without shadercross can refresh generated headers.
build-shaders-container:
    cd "{{invocation_directory()}}"
    bash "{{justfile_directory()}}/scripts/build-shaders-container.sh" \
      "{{invocation_directory()}}" \
      "{{docker}}" \
      "{{shader-container-image}}" \
      "{{shader-output-dir}}"
