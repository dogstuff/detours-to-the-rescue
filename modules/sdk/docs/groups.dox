/// @defgroup sdk_mods Mod API
/// APIs for a mod's DLL lifecycle, callbacks, logging, and exported entrypoints.
///
/// Keep globals limited to state owned by your mod. If you cache a
/// DTTR_Mods_Context pointer, treat it as valid until DTTR_Mod_Cleanup returns.
///
/// @code{.c}
/// #include <dttr_sdk.h>
///
/// static const DTTR_Mods_Context *mod_ctx;
///
/// DTTR_MODS_INFO("example-mod", "0.1.0", "dogstuff")
///
/// DTTR_MODS_INIT {
///     mod_ctx = ctx;
///     DTTR_MODS_LOG_INFO(ctx, "mod loaded");
///     return true;
/// }
///
/// DTTR_MODS_FRAME_BEGIN {
///     DTTR_MODS_LOG_DEBUG(mod_ctx, "frame: %llu", (unsigned long long)ctx->frame_index);
/// }
///
/// DTTR_MODS_CLEANUP {
///     mod_ctx = NULL;
/// }
/// @endcode

/// @defgroup sdk_core Core SDK
/// Result handling, AOB/signature scanning, patches, hooks, and patch groups.
///
/// Use patch groups to install related hooks and patches together. If a required
/// patch fails, the group rolls back the work it already applied.
///
/// PCDOGS `PatchSpec()` results describe what the SDK can install for a symbol:
/// REL32 targets become function-hook specs, HOTPATCH targets are reported as
/// unsupported, and data helpers install for typed pointer data.
///
/// @code{.c}
/// static DTTR_Core_PatchGroup *patches;
/// static DTTR_PCDOGS_F_PlayerSetLives_proto original_player_set_lives;
///
/// DTTR_MODS_INIT {
///     DTTR_Core_Result result = DTTR_Core_PatchGroupCreate(
///         &ctx->runtime,
///         &patches
///     );
///     if (!DTTR_Core_ResultOk(result)) {
///         DTTR_MODS_LOG_ERROR(ctx, "patch group failed: %s", result.message);
///         return false;
///     }
///
///     result = DTTR_Core_PatchGroupHookFunction(
///         patches,
///         DTTR_PCDOGS_F_PlayerSetLives->Address(),
///         (int)DTTR_PCDOGS_F_PlayerSetLives->HookPrologueSize(),
///         (void *)trace_player_set_lives,
///         (void **)&original_player_set_lives,
///         NULL
///     );
///     return DTTR_Core_ResultOk(result);
/// }
///
/// DTTR_MODS_CLEANUP {
///     DTTR_Core_PatchGroupRelease(&patches);
///     original_player_set_lives = NULL;
/// }
/// @endcode

/// @defgroup sdk_util Utilities
/// Small public helper APIs for common modding patterns.
///
/// Utility APIs provide convenience wrappers for common checks; they do not
/// introduce new game symbol knowledge. DTTR_Util_GetActiveActor and
/// DTTR_Util_SameActor cover comparisons between a hook actor and the engine's
/// current active actor. Direct
/// level-runtime enumeration belongs with the unstable Level_RuntimeData entity
/// array. Its slots are level-local runtime IDs, so pointers need
/// reacquisition after level or resource transitions.

/// @defgroup sdk_util_unstable Utilities (Experimental)
///
/// These APIs are included from the bundle header only when
/// DTTR_SDK_ENABLE_UNSTABLE is defined.

/// @defgroup sdk_runtime Runtime Hooking API
/// Low-level hook, patch, storage, and sigscan helpers.
///
/// The Core SDK is the mod-facing layer; raw handles are mainly for manual cleanup.
///
/// @code{.c}
/// static DTTR_Core_Hook *hook;
/// static void *original;
///
/// static bool install_raw_hook(uintptr_t site) {
///     hook = DTTR_Core_HookAttachFunction(site, 0, (void *)detour_fn, &original);
///     return hook != NULL;
/// }
///
/// static void cleanup_raw_hook() {
///     DTTR_Core_HookDetach(hook);
///     hook = NULL;
///     original = NULL;
/// }
/// @endcode
