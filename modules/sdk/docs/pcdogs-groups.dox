/// @defgroup sdk_pcdogs PCDOGS Symbols
/// Stable generated symbols and typed helper APIs for 102 Dalmatians: Puppies to the Rescue.
///
/// PCDOGS symbols give mods and SDK code typed names for known game functions,
/// globals, types, and patch targets. Those names come from SDK blueprints and
/// evidence recovered from supported game executables.
///
/// Use these APIs when a mod needs to read game state, call a known game
/// function, install a typed hook, or build a patch spec. They handle symbol
/// lookup for you, so mod code can use named SDK wrappers instead of hard-coded
/// addresses.
///
/// Prefer reading or hooking engine-owned state unless a symbol's documentation
/// says it is writable. This applies to globals such as current level data, the
/// render-scoped `player_actor`, native callback slots, and level-local runtime
/// entity arrays.
///
/// Some PCDOGS names describe native dispatch tables or callback-style
/// functions. `Resource_FixUp*` symbols convert package-relative offsets into
/// runtime-owned pointers.
///
/// Collision and level-geometry pointers belong to a specific node and current
/// level. Polygons resolve through their owning `Collision_Node`, so prefer using
/// collision pointers within that level or resource lifetime.
///
/// Source blueprints define the SDK names, layouts, and write policies. Generated
/// docs and build artifacts are derived from those blueprints.
///
/// DttR resolves required PCDOGS symbols before loading mods. Custom SDK hosts
/// and tests can call `DTTR_PCDOGS_ResolveAll()` when they need to resolve
/// symbols explicitly.
///
/// @code{.c}
/// #include <dttr_sdk.h>
///
/// static int32_t last_lives;
///
/// DTTR_MODS_FRAME_BEGIN {
///     int32_t lives = 0;
///     if (DTTR_PCDOGS_D_SaveFilePlayerLives->Read(&lives)) {
///         last_lives = lives;
///     }
/// }
/// @endcode
///
/// @code{.c}
/// // Returns FALSE when MoviePlayFile is unavailable.
/// BOOL played = DTTR_PCDOGS_F_MoviePlayFile->Call(
///     &ctx->runtime,
///     movie_path,
///     0,
///     FALSE
/// );
/// @endcode

/// @defgroup sdk_pcdogs_unstable PCDOGS Symbols (Unstable)
/// Experimental/generated symbols that may change without compatibility guarantees.
///
/// Unstable PCDOGS symbols expose reverse-engineered game data for experiments,
/// tooling, and early mod development.
///
/// Names, typedefs, layouts, hook metadata, and symbol availability may change.
///
/// @code{.c}
/// #define DTTR_SDK_ENABLE_UNSTABLE
/// #include <dttr_sdk.h>
///
/// DTTR_MODS_INIT {
///     if (!DTTR_PCDOGS_ResolveAll(&ctx->runtime)) {
///         DTTR_MODS_LOG_WARN(ctx, "unstable PCDOGS symbols were unavailable");
///     }
///
///     // Unstable symbol hooks belong here; cleanup stays explicit.
///     return true;
/// }
/// @endcode
