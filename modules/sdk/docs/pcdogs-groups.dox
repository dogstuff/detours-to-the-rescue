/// @defgroup sdk_pcdogs PCDOGS Symbols
/// Stable generated symbols and typed helper APIs for 102 Dalmatians: Puppies to the Rescue.
///
/// PCDOGS generated symbols describe known game functions, globals, types, and
/// patch targets for supported 102 Dalmatians executables. Names come from SDK
/// blueprints and recovered executable evidence. Stable APIs preserve the public
/// SDK contract by keeping engine-owned state read/hook-only unless the symbol doc
/// marks it writable. When recovery work renames a gameplay/runtime symbol, the
/// new generated name is canonical.
///
/// These symbols cover game-state reads, known function calls, typed hooks, and
/// patch specs without hand-written lookup logic. Engine-owned globals, including
/// current level data, render-scoped player_actor, and native callback slots, are
/// read/hook targets. Writes are limited to symbols whose docs mark them writable.
/// Level-runtime entity arrays hold level-local runtime slots.
///
/// Callback-like PCDOGS names describe native dispatch tables/functions.
/// `Resource_FixUp*` symbols rebase package-relative offsets into runtime-owned
/// pointers.
///
/// Collision and level-geometry pointers are valid only for the owning node and
/// current level. Polygons resolve through their owning `Collision_Node`. Use
/// collision pointers only within the owning level/resource lifetime.
///
/// Source blueprints are authoritative for SDK names, layouts, and write policies;
/// generated docs/build artifacts are derived outputs.
///
/// DttR resolves required PCDOGS symbols before loading mods; custom SDK hosts
/// and tests can call `DTTR_PCDOGS_ResolveAll()` explicitly.
///
/// @code{.c}
/// #include <dttr_sdk.h>
///
/// static int32_t last_lives;
///
/// DTTR_MODS_FRAME_BEGIN {
///     int32_t lives = 0;
///     if (DTTR_PCDOGS_D_SaveFilePlayerLives->Read(&lives)) {
///         last_lives = lives;
///     }
/// }
/// @endcode
///
/// @code{.c}
/// // Returns FALSE when MoviePlayFile is unavailable.
/// BOOL played = DTTR_PCDOGS_F_MoviePlayFile->Call(
///     &ctx->runtime,
///     movie_path,
///     0,
///     FALSE
/// );
/// @endcode

/// @defgroup sdk_pcdogs_unstable PCDOGS Symbols (Unstable)
/// Experimental/generated symbols that may change without compatibility guarantees.
///
/// Unstable PCDOGS symbols expose reverse-engineered game data for experiments,
/// tooling, and early mod development.
///
/// Names, typedefs, layouts, hook metadata, and symbol availability may change.
///
/// @code{.c}
/// #define DTTR_SDK_ENABLE_UNSTABLE
/// #include <dttr_sdk.h>
///
/// DTTR_MODS_INIT {
///     if (!DTTR_PCDOGS_ResolveAll(&ctx->runtime)) {
///         DTTR_MODS_LOG_WARN(ctx, "unstable PCDOGS symbols were unavailable");
///     }
///
///     // Unstable symbol hooks belong here; cleanup stays explicit.
///     return true;
/// }
/// @endcode
